generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  password     String
  role         String     @default("user") // user, admin
  plan         String     @default("gratuit") // gratuit, diambar, vip_king
  points       Int        @default(0)
  referralCode String     @unique @default(cuid())
  referredBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  annonces     Annonce[]
  purchases    Purchase[]
  referrals    Referral[] @relation("Referrer")
  referredByR  Referral?  @relation("Referred")
}

model Annonce {
  id          String    @id @default(cuid())
  title       String
  description String?
  price       Int
  category    String
  location    String    @default("Dakar")
  emoji       String    @default("📦")
  phone       String?   // Numéro de téléphone du vendeur
  whatsapp    String?   // Numéro WhatsApp du vendeur
  isVip       Boolean   @default(false)
  vipType     String?   // diambar, vip_king
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  annonceId  String
  points     Int      @default(1500) // Coût pour débloquer le contact
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  annonce    Annonce  @relation(fields: [annonceId], references: [id])

  @@unique([userId, annonceId]) // Un utilisateur ne paie qu'une fois par annonce
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  points     Int      @default(400)
  createdAt  DateTime @default(now())

  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
  referred   User     @relation("Referred", fields: [referredId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([referredId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  password     String?    // Optional for OAuth users
  avatar       String?    // OAuth avatar URL
  provider     String     @default("email") // email, google, facebook
  providerId   String?    // OAuth provider user ID
  role         String     @default("user") // user, admin
  plan         String     @default("gratuit") // gratuit, diambar, vip_king
  points       Int        @default(0)
  referralCode String     @unique @default(cuid())
  referredBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  annonces     Annonce[]
  purchases    Purchase[]
  referrals    Referral[] @relation("Referrer")
  referredByR  Referral?  @relation("Referred")
  pointPurchases PointPurchase[]
  subscriptions   Subscription[]
}

model Annonce {
  id          String    @id @default(cuid())
  title       String
  description String?
  price       Int
  category    String
  location    String    @default("Dakar")
  emoji       String    @default("📦")
  phone       String?   // Numéro de téléphone du vendeur
  whatsapp    String?   // Numéro WhatsApp du vendeur
  isVip       Boolean   @default(false)
  vipType     String?   // diambar, vip_king
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  annonceId  String
  points     Int      @default(1500) // Coût pour débloquer le contact
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  annonce    Annonce  @relation(fields: [annonceId], references: [id])

  @@unique([userId, annonceId]) // Un utilisateur ne paie qu'une fois par annonce
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  points     Int      @default(400)
  createdAt  DateTime @default(now())

  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
  referred   User     @relation("Referred", fields: [referredId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([referredId])
}

model PointPurchase {
  id           String   @id @default(cuid())
  userId       String
  amountFcfa   Int      // Montant payé en FCFA
  pointsAdded  Int      // Points crédités
  status       String   @default("pending") // pending, completed, failed
  paymentMethod String? // wave, orange_money, bank_transfer
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  plan         String   // diambar, vip_king
  priceFcfa    Int      // Prix payé en FCFA
  status       String   @default("active") // active, expired, cancelled
  startDate    DateTime @default(now())
  endDate      DateTime? // Date d'expiration
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

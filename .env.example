# Base de données PostgreSQL
# Pour le dev local (installez PostgreSQL ou utilisez la DB Vercel distante) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wakhmastore"

# Pour Vercel, utilisez la variable fournie par Vercel Postgres :
# DATABASE_URL="postgresql://default:xxxxx@ep-xxxxx.us-east-1.aws.neon.tech/verceldb?sslmode=require"

# Authentification
JWT_SECRET="changez-cette-cle-secrete-en-production-avec-une-cle-longue-et-complexe"

# Google OAuth (obligatoire pour la connexion Google)
GOOGLE_CLIENT_ID="votre-google-client-id"
GOOGLE_CLIENT_SECRET="votre-google-client-secret"

# Facebook OAuth (obligatoire pour la connexion Facebook)
FACEBOOK_CLIENT_ID="votre-facebook-client-id"
FACEBOOK_CLIENT_SECRET="votre-facebook-client-secret"

# URL de base (obligatoire pour les callbacks OAuth)
# En dev local :
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# En production Vercel :
# NEXT_PUBLIC_BASE_URL="https://wakhmastore.com"

# ============================================
# Wakhma Store - Environment Variables
# ============================================

# Database (PostgreSQL - Neon/Vercel Postgres)
# Get this from: https://vercel.com/dashboard → Storage → Postgres → .env local
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Base URL (your Vercel deployment URL)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-generated-secret-here

# NextAuth Secret - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ============================================
# Vercel Cron Authentication
# ============================================
# Secret for authenticating Vercel Cron requests to /api/admin/check-expired
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret-here

# ============================================
# Upstash Redis (Optional - for caching/rate limiting)
# ============================================
# Get these from: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# ============================================
# OAuth Providers (Optional)
# ============================================
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth - Get from: https://developers.facebook.com/apps/
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ============================================
# WhatsApp OTP Configuration (Optional)
# ============================================
# WHATSAPP_API_TOKEN=your-meta-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_VERIFY_TEMPLATE=verification_code

# ============================================
# Upstash Redis (for rate limiting & OTP — works in Vercel serverless)
# ============================================
# Get free tier at: https://upstash.com → Create Redis → copy REST URL & token
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

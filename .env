# ============================================
# Wakhma Store - Environment Variables
# ============================================

# Database (PostgreSQL - Neon/Vercel Postgres)
DATABASE_URL=postgresql://placeholder:placeholder@ep-placeholder.us-east-2.aws.neon.tech/wakhma?sslmode=require

# Base URL
NEXT_PUBLIC_BASE_URL=https://my-project-orcin-eight-67.vercel.app

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=wakhma-store-dev-secret-key-not-for-production

# ============================================
# WhatsApp OTP Configuration
# ============================================
# Option 1: WhatsApp Cloud API (Meta Business) — Recommended for production
# Get these from: https://business.facebook.com/ > WhatsApp > API Setup
# WHATSAPP_API_TOKEN=your-meta-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_VERIFY_TEMPLATE=verification_code

# Option 2: Fallback mode (no API needed)
# If WHATSAPP_API_TOKEN is not set, the system will use wa.me links
# Users will receive the code by opening a WhatsApp link
